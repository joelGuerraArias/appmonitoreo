# Archivo de ejemplo para configurar secrets de Streamlit
# Copia este archivo como .streamlit/secrets.toml y completa con tus credenciales reales
# IMPORTANTE: NUNCA subas el archivo secrets.toml a Git

[cloudinary]
cloud_name = "tu_cloud_name"
api_key = "tu_api_key"
api_secret = "tu_api_secret"

[webhook]
url = "https://hook.us1.make.com/tu_webhook_url"

[telegram]
bot_token = "tu_bot_token"
chat_id = "@tu_canal_o_chat_id"

[openai]
api_key = "YOUR_OPENAI_API_KEY"







